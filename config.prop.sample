##########################################################
# All variables in config.prop are optional
# Removing or leaving them blank will keep default values
##########################################################

# The version name of Magisk. Default: git HEAD short SHA1
version=string

# Secure directory where Magisk stores modules, binaries and database.
# Change to avoid detection by path-based scans. Default: /data/adb
# Example: secureDir=/data/.system
secureDir=/data/adb

# Output path. Default: out
outdir=string

# List of ABIs to build, separated with ','
# Default: armeabi-v7a,x86,arm64-v8a,x86_64
abiList=[string]

#####################################################
# Signing configs for signing zips and APKs
# These 4 variables has to be either all set or not
#####################################################

# Path to keystore file
keyStore=string
# Keystore password
keyStorePass=string
# The desired key alias in the keystore
keyAlias=string
# Password of specified key alias
keyPass=string

###########################################################
# Build Spoof — override ro.build.* to pass Play Integrity
# Leave empty to disable spoofing entirely
###########################################################

# Full build fingerprint (single string, overrides individual fields below)
# Example: google/tokay/tokay:15/AP4A.241205.013/12621605:user/release-keys
# spoofFingerprint=

# ro.product.manufacturer
# spoofManufacturer=Google

# ro.product.model
# spoofModel=Pixel 9

# ro.product.name (device codename)
# spoofProduct=tokay

# ro.product.device
# spoofDevice=tokay

# ro.build.id
# spoofBuildId=AP4A.241205.013

# ro.build.version.security_patch (YYYY-MM-DD)
# spoofSecurityPatch=2024-12-05

# ro.build.version.release (Android version string)
# spoofVersionRelease=15

###########################################################
# Per-Build Randomization
###########################################################

# Randomize the binary/daemon names each build (default: true)
# Binary names are derived from a random 5-char BUILD_ID so every
# build produces unique executable names — no shared string across installs.
# randomizeName=true

# Randomize the secure storage path each build instead of using secureDir above
# Generates a random /data/.<5-char> path per build
# randomizeSecureDir=false
